# WeChatAI 配置模板
# 第一次运行 EXE 时会自动复制成本目录下的 .env。
# 修改 .env 后重启 WeChatAI.exe 生效。

# --- AI 提供商 ---
# 可选：gemini / openai
AI_PROVIDER=openai

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenAI 兼容接口，例如 OpenAI / DeepSeek / 中转 API / 本地模型网关
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Claude 微信聊天记录 Agent ---
# 如果要在微信里通过 WeixinClawBot 直接问本地聊天记录，填这里。
CLAUDE_AGENT_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-sonnet-4-6
AGENT_WECHAT_ENTRY_NAME=WeixinClawBot
AGENT_PERMISSION_MODE=confirm
AGENT_POLL_SECONDS=3

# --- Codex-like developer mode ---
# Enables the WeChat Agent to inspect this project, propose file edits,
# and propose shell commands. Writes/commands require `confirm <id>` unless
# AGENT_DEV_AUTO_APPLY=true.
AGENT_DEV_MODE_ENABLED=false
AGENT_DEV_WORKSPACE=
AGENT_DEV_AUTO_APPLY=false
AGENT_DEV_MAX_STEPS=8
AGENT_DEV_COMMAND_TIMEOUT=60
# Let Claude semantically route WeChat messages to development / records / direct chat.
# Keep enabled so the agent is not limited to rigid keyword matching.
AGENT_SMART_ROUTER_ENABLED=true
# Optional built-in Claude Code planner. It is read-only here; edits/commands still require confirmation.
AGENT_DEV_ENABLE_CLAUDE_CODE_TOOL=true
CLAUDE_CODE_CLI_PATH=
CLAUDE_CODE_MODEL=sonnet

# --- 同步与解密 ---
SYNC_INTERVAL_SECONDS=7
DECRYPT_INTERVAL_SECONDS=300

# --- 每日微信总结 ---
# 开启后，后端会在指定时间总结最近 N 小时所有已同步微信记录，
# 并通过微信窗口发送给 DAILY_SUMMARY_RECEIVER。
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_TIME=09:00
DAILY_SUMMARY_RECEIVER=文件传输助手
DAILY_SUMMARY_HOURS=24
DAILY_SUMMARY_MAX_MESSAGES=50000

# Weixin 4.x 数据库目录。留空时自动检测。
WX_DB_DIR=

# Weixin 4.x 数据库 key，64 位十六进制。留空时尝试自动读取/扫描。
WX_DB_KEY=

# --- 本地服务 ---
APP_HOST=127.0.0.1
APP_PORT=8090
INFERENCE_PORT=8091

# --- 数据存储 ---
# 便携版建议保持 ./data，数据会放在 EXE 同目录的 data 文件夹。
DATA_DIR=./data

# 本地训练/推理 Python。没有本地模型训练需求可以留空。
INFERENCE_PYTHON=
