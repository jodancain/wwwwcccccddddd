# ==============================
# WeChatAI 配置文件
# 复制此文件为 .env 并填入你的配置
# ==============================

# --- AI 提供商 ---
# 选择 "gemini" 或 "openai"
AI_PROVIDER=gemini

# Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenAI 兼容 API (支持 OpenAI / DeepSeek / 本地模型)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- 同步设置 ---
# 消息同步间隔（秒），越小越接近实时
SYNC_INTERVAL_SECONDS=7
# 数据库解密间隔（秒）
DECRYPT_INTERVAL_SECONDS=60

# --- 服务器 ---
APP_HOST=127.0.0.1
APP_PORT=8080

# --- 数据存储 ---
DATA_DIR=./data

# Optional Weixin 4.x database key (64 hex chars). Leave empty to scan memory.
WX_DB_KEY=
